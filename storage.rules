rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────────

    function esAdmin() {
      return request.auth != null
          && request.auth.uid in ['V3fmWq47WxYNeEvnjSbTbsLlhXE2'];
    }

    // Cross-service: lee la colección usuarios de Firestore para chequear
    // que este uid tenga `slug` entre los negocios que administra.
    function esDuenoDe(slug) {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
          && slug in firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.negociosIds;
    }

    // Hasta 5 MB; sólo imágenes o PDF.
    function archivoValido() {
      return request.resource != null
          && request.resource.size < 5 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType == 'application/pdf');
    }

    // ─────────────────────────────────────────────────────────────────
    // COMPROBANTES DE PAGO DE TURNOS
    // Estructura: comprobantes-turnos/{slug-negocio}/{archivo}
    // ─────────────────────────────────────────────────────────────────

    match /comprobantes-turnos/{slug}/{archivo=**} {
      // Subir: cualquier autenticado (incluso anónimo del flujo público).
      allow write: if request.auth != null && archivoValido();
      // Leer / listar: sólo dueño del negocio o admin.
      allow read: if esAdmin() || esDuenoDe(slug);
    }

    // ─────────────────────────────────────────────────────────────────
    // COMPROBANTES DE PAGO DE SUSCRIPCIÓN MENSUAL A RÍO TECH
    // Estructura: comprobantes-suscripcion/{archivo}
    // ─────────────────────────────────────────────────────────────────

    match /comprobantes-suscripcion/{archivo=**} {
      allow write: if request.auth != null && archivoValido();
      // Sólo el admin de Río Tech ve los comprobantes de suscripción.
      allow read: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // Cualquier otra ruta del bucket queda bloqueada.
    // ─────────────────────────────────────────────────────────────────
  }
}
