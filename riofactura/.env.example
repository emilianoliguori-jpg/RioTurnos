# Credenciales de Firebase para RioFactura.
# Copiá este archivo como ".env" y completá los valores.
# Podés reutilizar el MISMO proyecto Firebase que Rio Turnos (las colecciones
# de esta app viven bajo "empresas/**", separadas de "negocios/**"), o usar un
# proyecto Firebase propio.
#
# El .env NO se sube a git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
