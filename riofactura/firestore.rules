rules_version = '2';

// Reglas de Firestore para RioFactura.
// Cada usuario administra UNA empresa cuyo id de documento es su propio uid.
// Aislamiento total: nadie lee ni escribe la empresa de otro. Todas las
// subcolecciones (clientes, proveedores, comprobantes, compras, cobros,
// pagos, contadores) heredan la misma regla.
service cloud.firestore {
  match /databases/{database}/documents {

    match /empresas/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{documentos=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Todo lo demás queda denegado por no tener regla.
  }
}
