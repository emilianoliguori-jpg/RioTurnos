rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────────

    // Lista blanca de admins de Río Tech. Mantenerla en sync con
    // src/lib/admins.js (la app respeta la misma lista en la UI).
    function esAdmin() {
      return request.auth != null
          && request.auth.uid in [
               'MeNAiyeN2lgOZMFmQyJYx2PxEWw2', // Río Tech · hola@riotech.ar
               'V3fmWq47WxYNeEvnjSbTbsLlhXE2'  // Emiliano · emilianoliguori@gmail.com
             ];
    }

    // ¿Hay sesión activa? Cubre Google login y login anónimo.
    function estaLogueado() {
      return request.auth != null;
    }

    // ¿El usuario logueado tiene este slug en su array negociosIds?
    // Usado para chequear si puede administrar un negocio.
    // Costo: una lectura extra del doc usuarios/{uid} por evaluación.
    function esDuenoDe(slug) {
      return request.auth != null
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && slug in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.negociosIds;
    }

    // Validación mínima de un turno nuevo: estado válido + campos esperados.
    // No validamos montos exactos (sería caro y frágil) — la UI ya valida.
    function turnoValido(d) {
      return d.estado in ['confirmado', 'pendiente_pago']
          && d.fecha is string
          && d.hora is string
          && d.duracionMinutos is number
          && d.duracionMinutos > 0
          && d.servicioId is string
          && d.servicioNombre is string;
    }

    // Validación mínima de un slot (subcolección espejo, pública para read).
    // No validamos estado contra una lista cerrada porque el backfill puede
    // crear slots con estado "atendido" o "cancelado" para turnos viejos.
    // La UI filtra cancelados al leer; un estado raro no rompe nada.
    function slotValido(d) {
      return d.estado is string
          && d.fecha is string
          && d.hora is string
          && d.duracionMinutos is number
          && d.duracionMinutos > 0
          && d.servicioId is string;
    }

    // Validación de una solicitud de suscripción.
    function solicitudValida(d) {
      return d.estado == 'pendiente'
          && d.nombreNegocio is string
          && d.slug is string
          && d.email is string
          && d.planKey is string;
    }

    // Campos del negocio que SÓLO admin puede modificar:
    //   - ultimoPagoMes: el admin marca tras verificar la transferencia.
    //     Si fuera escribible por el dueño, podría auto-marcarse pagado.
    //   - plan, estado: definen la suscripción y vigencia comercial.
    //   - emailDuenoAutorizado: vincula el negocio a un email.
    //   - creadoEn, slug: campos de identidad del documento.
    // El dueño puede editar todo el resto (nombre, color, horarios, etc.).
    function tocaCamposSoloAdmin(req, res) {
      return req.resource.data.diff(res.data).affectedKeys()
                .hasAny([
                  'ultimoPagoMes',
                  'plan',
                  'estado',
                  'emailDuenoAutorizado',
                  'creadoEn',
                  'slug',
                ]);
    }

    // ─────────────────────────────────────────────────────────────────
    // NEGOCIOS
    // ─────────────────────────────────────────────────────────────────

    match /negocios/{slug} {
      // Lectura PÚBLICA: el flujo público de reserva la necesita.
      allow read: if true;
      // Crear / borrar negocios: en la práctica sólo admin (esDuenoDe exige
      // que el slug ya esté en negociosIds del usuario — imposible en create).
      allow create, delete: if esAdmin() || esDuenoDe(slug);
      // Update: admin puede todo; el dueño puede todo EXCEPTO los campos
      // administrativos. Defensa contra DevTools / API directa.
      allow update: if esAdmin()
                    || (esDuenoDe(slug) && !tocaCamposSoloAdmin(request, resource));

      // Servicios y profesionales: misma lógica.
      match /servicios/{id} {
        allow read: if true;
        allow create, update, delete: if esAdmin() || esDuenoDe(slug);
      }
      match /profesionales/{id} {
        allow read: if true;
        allow create, update, delete: if esAdmin() || esDuenoDe(slug);
      }

      // Turnos: cualquiera autenticado los CREA (cliente público anónimo).
      // Sólo el dueño/admin lee, modifica o cancela.
      match /turnos/{id} {
        allow create: if estaLogueado() && turnoValido(request.resource.data);
        allow read, update, delete: if esAdmin() || esDuenoDe(slug);
      }

      // Slots: subcolección espejo pública para que el cliente público pueda
      // calcular disponibilidad SIN ver datos personales (que viven en turnos).
      // Lectura pública. Escritura validada (igual modelo que turnos).
      // Update/delete sólo dueño/admin — los slots se mantienen sincronizados
      // por el servicio turnos.js (writeBatch).
      match /slots/{id} {
        allow read: if true;
        allow create: if estaLogueado() && slotValido(request.resource.data);
        allow update, delete: if esAdmin() || esDuenoDe(slug);
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // USUARIOS — vínculo uid ↔ negocios
    // ─────────────────────────────────────────────────────────────────

    match /usuarios/{uid} {
      // El propio user lee y escribe su doc (vinculación post-login).
      // Admin puede todo.
      allow read, create, update: if esAdmin()
                                   || (request.auth != null && request.auth.uid == uid);
      allow delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────────
    // SOLICITUDES de suscripción
    // ─────────────────────────────────────────────────────────────────

    match /solicitudes/{id} {
      // Crear: cualquier autenticado (incluso anónimo del flujo público).
      allow create: if estaLogueado() && solicitudValida(request.resource.data);
      // Ver / modificar / borrar: sólo admin.
      allow read, update, delete: if esAdmin();
    }

    // ─────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // Cualquier ruta no listada arriba queda denegada por no tener regla.
    // ─────────────────────────────────────────────────────────────────
  }
}
